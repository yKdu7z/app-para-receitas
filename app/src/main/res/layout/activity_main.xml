<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:fontFamily="serif"
        android:text="@string/titulo_lista"
        android:textColor="@color/texto"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/txtQuantidade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoFiltros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@+id/chipTodas"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodas"
                style="@style/ChipFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filtro_todas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFavoritas"
                style="@style/ChipFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filtro_favoritas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSalgados"
                style="@style/ChipFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/categoria_salgados" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDoces"
                style="@style/ChipFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/categoria_doces" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBebidas"
                style="@style/ChipFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/categoria_bebidas" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaReceitas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/txtVazio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="32dp"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
